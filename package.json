{
  "name": "lorecreator",
  "productName": "LoreCreator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Criador de histórias para jogos: codex do mundo, linha do tempo e roteiros ramificados.",
  "author": "VitorJacintho",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/runtime.test.mjs scripts/simulate.test.mjs scripts/model.test.mjs",
    "icon": "node scripts/make-icon.mjs",
    "app:dev": "node scripts/dev-app.mjs",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xyflow/react": "^12.12.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "io.github.vitorjacintho.lorecreator",
    "productName": "LoreCreator",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "lore",
        "name": "Projeto LoreCreator",
        "description": "Projeto do LoreCreator",
        "icon": "build/icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LoreCreator",
      "artifactName": "LoreCreator-${version}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "LoreCreator-${version}-portatil.${ext}"
    }
  }
}
